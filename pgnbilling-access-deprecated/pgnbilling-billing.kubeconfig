apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://k8s-lb-staging.pgn.co.id:6443
  name: kubernetes
contexts:
- context:
    cluster: kubernetes
    namespace: billing-pgnbilling-staging
    user: pgnbilling
  name: pgnbilling-billing
current-context: pgnbilling-billing
kind: Config
preferences: {}
users:
- name: pgnbilling
  user:
    client-certificate: pgnbilling-billing.crt
    client-key: pgnbilling-billing.key
